{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "9.5.0"
    },
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": "2.44.0"
    },
    {
      "type": "panel",
      "id": "timeseries",
      "name": "Time series",
      "version": ""
    },
    {
      "type": "panel",
      "id": "stat",
      "name": "Stat",
      "version": ""
    },
    {
      "type": "panel",
      "id": "table",
      "name": "Table",
      "version": ""
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": false,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 1,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "7d rolling conversion of initiated to succeeded payments per plan. Uses clamp_min to avoid division by zero when there are no initiations in the period.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "continuous-BlPu"
          },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 16,
            "gradientMode": "opacity",
            "hideFrom": {
              "graph": false,
              "legend": false,
              "tooltip": false
            },
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 4,
            "scaleDistribution": {
              "type": "linear"
            },
            "showPoints": "auto",
            "spanNulls": true,
            "stacking": {
              "group": "A",
              "mode": "none"
            }
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.4
              },
              {
                "color": "green",
                "value": 0.7
              }
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "id": 5,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull"
          ],
          "displayMode": "table",
          "placement": "right",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "exemplar": false,
          "expr": "(\n  sum by (plan_code) (increase(payments_succeeded_total{plan_code=~\"$plan\",service=~\"$service\",env=~\"$env\"}[7d]))\n    or sum by (plan_code) (increase(payments_succeeded_total{plan_code=~\"$plan\",env=~\"$env\"}[7d]))\n    or sum by (plan_code) (increase(payments_succeeded_total{plan_code=~\"$plan\"}[7d]))\n)\n/\nclamp_min(\n  (\n    sum by (plan_code) (increase(payments_initiated_total{plan_code=~\"$plan\",service=~\"$service\",env=~\"$env\"}[7d]))\n      or sum by (plan_code) (increase(payments_initiated_total{plan_code=~\"$plan\",env=~\"$env\"}[7d]))\n      or sum by (plan_code) (increase(payments_initiated_total{plan_code=~\"$plan\"}[7d]))\n  ),\n  1\n)",
          "interval": "",
          "legendFormat": "{{plan_code}}",
          "refId": "A"
        }
      ],
      "title": "Plan Conversion (7d)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Net revenue after refunds over the selected range. Values are converted from minor units.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "currencyUSD"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Refunds"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 6,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull"
          ],
          "displayMode": "table",
          "placement": "right",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "exemplar": false,
          "expr": "(\n  sum by (plan_code) (increase(payments_revenue_minor_total{plan_code=~\"$plan\",service=~\"$service\",env=~\"$env\"}[$__interval]))\n    or sum by (plan_code) (increase(payments_revenue_minor_total{plan_code=~\"$plan\",env=~\"$env\"}[$__interval]))\n    or sum by (plan_code) (increase(payments_revenue_minor_total{plan_code=~\"$plan\"}[$__interval]))\n) / 100",
          "interval": "",
          "legendFormat": "{{plan_code}} Revenue",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "exemplar": false,
          "expr": "(\n  sum by (plan_code) (increase(payments_refunds_minor_total{plan_code=~\"$plan\",service=~\"$service\",env=~\"$env\"}[$__interval]))\n    or sum by (plan_code) (increase(payments_refunds_minor_total{plan_code=~\"$plan\",env=~\"$env\"}[$__interval]))\n    or sum by (plan_code) (increase(payments_refunds_minor_total{plan_code=~\"$plan\"}[$__interval]))\n) / 100",
          "interval": "",
          "legendFormat": "{{plan_code}} Refunds",
          "refId": "B"
        }
      ],
      "title": "Revenue vs Refunds",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Failed payments broken down by reason to watch for regressions in billing integrations.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "align": "auto",
            "displayMode": "auto",
            "inspect": false
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 10
      },
      "id": 7,
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "desc": true,
            "displayName": "Value"
          }
        ]
      },
      "pluginVersion": "9.5.0",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "exemplar": false,
          "expr": "sum by (plan_code, reason) (increase(payments_failed_total{plan_code=~\"$plan\",service=~\"$service\",env=~\"$env\"}[$__range]))\n  or sum by (plan_code, reason) (increase(payments_failed_total{plan_code=~\"$plan\",env=~\"$env\"}[$__range]))\n  or sum by (plan_code, reason) (increase(payments_failed_total{plan_code=~\"$plan\"}[$__range]))",
          "interval": "",
          "legendFormat": "{{plan_code}} · {{reason}}",
          "refId": "A"
        }
      ],
      "title": "Failed Payments by Reason",
      "type": "table"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Webhook processing lag (p95) to ensure partner callbacks stay within SLA.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "continuous-GrYlRd"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 10
              },
              {
                "color": "red",
                "value": 60
              }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 10
      },
      "id": 8,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull"
          ],
          "displayMode": "table",
          "placement": "right",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "exemplar": false,
          "expr": "histogram_quantile(0.95, sum by (le) (rate(webhook_lag_seconds_bucket{service=~\"$service\",env=~\"$env\"}[$__interval])))\n  or histogram_quantile(0.95, sum by (le) (rate(webhook_lag_seconds_bucket{env=~\"$env\"}[$__interval])))\n  or histogram_quantile(0.95, sum by (le) (rate(webhook_lag_seconds_bucket[$__interval])))",
          "interval": "",
          "legendFormat": "p95 lag",
          "refId": "A"
        }
      ],
      "title": "Webhook Lag p95",
      "type": "timeseries"
    }
  ],
  "refresh": "1m",
  "schemaVersion": 39,
  "style": "dark",
  "tags": [
    "billing",
    "growth"
  ],
  "templating": {
    "list": [
      {
        "name": "prometheus_ds",
        "type": "datasource",
        "hide": 2,
        "label": "Prometheus",
        "query": "prometheus",
        "current": {
          "text": "Prometheus",
          "value": "${DS_PROMETHEUS}"
        },
        "options": []
      },
      {
        "name": "env",
        "label": "Env",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "definition": "label_values(campaign_state_transitions_total, env)",
        "includeAll": true,
        "multi": true,
        "refresh": 1,
        "regex": "",
        "sort": 0,
        "query": "label_values(campaign_state_transitions_total, env)",
        "current": {
          "selected": true,
          "text": "All",
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "definition": "label_values(campaign_scheduler_lag_seconds, partition)",
        "includeAll": true,
        "multi": true,
        "refresh": 1,
        "regex": "",
        "sort": 0,
        "query": "label_values(campaign_scheduler_lag_seconds, partition)",
        "current": {
          "selected": true,
          "text": "All",
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "plan",
        "label": "Plan",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "definition": "label_values(payments_initiated_total, plan_code)",
        "includeAll": true,
        "multi": true,
        "refresh": 1,
        "regex": "",
        "sort": 0,
        "query": "label_values(payments_initiated_total, plan_code)",
        "current": {
          "selected": true,
          "text": "All",
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "time": {
    "from": "now-14d",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "30s",
      "1m",
      "5m",
      "15m",
      "30m",
      "1h",
      "2h",
      "1d"
    ]
  },
  "timezone": "",
  "title": "Growth & Billing",
  "uid": null,
  "version": 1,
  "weekStart": ""
}
