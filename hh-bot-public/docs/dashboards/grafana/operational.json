        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "definition": "label_values(campaign_state_transitions_total, env)",
        "includeAll": true,
        "multi": true,
        "refresh": 1,
        "regex": "",
        "sort": 0,
        "query": "label_values(campaign_state_transitions_total, env)",
        "current": {
          "selected": true,
          "text": "All",
          "value": [
            "$__all"
