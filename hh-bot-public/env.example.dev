# env.example.dev - template for running backend locally without Docker

APP_ENV=development
APP_DEBUG=true
APP_VERSION=dev
LOG_LEVEL=DEBUG
WEB_PORT=8000
APP_MODULE=backend.app.main:app
TZ=UTC

POSTGRES_DB=hh_dev
POSTGRES_USER=hh
POSTGRES_PASSWORD=devpass
DATABASE_URL=postgresql+asyncpg://hh:devpass@localhost:5432/hh_dev
NEON_DATABASE_URL=
DATABASE_URL_SQLITE=sqlite+aiosqlite:///./dev.db
REDIS_URL=redis://localhost:6379/0

SECRET_KEY=CHANGE_ME_DEV_SECRET
ACCESS_TOKEN_EXPIRE_MINUTES=60
ADMIN_USER=admin
ADMIN_PASS=devadmin
ADMIN_SECRET_TOKEN=devtoken
ADMIN_BASIC_REALM=Restricted

LOG_FILE=logs/app.log
BOT_LOG_DIR=logs
BOT_LOG_FILE=logs/bot.log

ENABLE_TELEGRAM_BOT=0
TELEGRAM_BOT_TOKEN=
BOT_TOKEN=
CF_TUNNEL_TOKEN=

CORS_ORIGINS=http://localhost,http://127.0.0.1
HH_API_BASE=https://api.hh.ru
VITE_API_BASE=https://localhost:8443/api
VITE_USE_MOCKS=1
