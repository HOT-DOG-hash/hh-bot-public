# Base application settings
APP_ENV=prod
APP_MODULE=backend.app.main:app
WEB_PORT=8000
TZ=Europe/Moscow
LOG_LEVEL=INFO
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Secrets (replace placeholders)
SECRET_KEY=CHANGE_ME
ADMIN_USER=admin@example
ADMIN_PASS=changeMe123!
ADMIN_SECRET_TOKEN=CHANGE_ME
ADMIN_BASIC_REALM=HHOFFER Admin

# Database / cache
DATABASE_URL=postgresql+asyncpg://USER:PASS@HOST:5432/DB
REDIS_URL=redis://HOST:6379/0

# Integrations
BASE_URL=https://api.example.com
PREMIUM_ENABLED=false
PAYMENT_PROVIDER=yoomoney
YOOMONEY_TOKEN=CHANGE_ME

# Telegram / Cloudflare
ENABLE_TELEGRAM_BOT=0
TELEGRAM_BOT_TOKEN=CHANGE_ME
CF_TUNNEL_TOKEN=CHANGE_ME

# Optional overrides
PUBLIC_BASE_URL=https://api.example.com
CORS_ORIGINS=["https://example.com"]
