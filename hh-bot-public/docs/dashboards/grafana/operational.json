          "uid": "${DS_PROMETHEUS}"
        },
        "definition": "label_values(campaign_scheduler_lag_seconds, partition)",
        "includeAll": true,
        "multi": true,
        "refresh": 1,
        "regex": "",
        "sort": 0,
        "query": "label_values(campaign_scheduler_lag_seconds, partition)",
        "current": {
          "selected": true,
          "text": "All",
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "plan",
        "label": "Plan",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "definition": "label_values(payments_initiated_total, plan_code)",
        "includeAll": true,
        "multi": true,
        "refresh": 1,
        "regex": "",
        "sort": 0,
        "query": "label_values(payments_initiated_total, plan_code)",
        "current": {
          "selected": true,
          "text": "All",
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
