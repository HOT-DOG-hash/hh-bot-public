# Database
POSTGRES_DB=<set_in_env>
POSTGRES_USER=<set_in_env>
POSTGRES_PASSWORD=h<set_in_env>


# Redis
REDIS_URL=redis://cache:6379/0

# Backend
DATABASE_URL=<set_in_env>
SECRET_KEY=<set_in_env>
ADMIN_USER=<set_in_env>
ADMIN_PASS=<set_in_env>
ADMIN_SECRET_TOKEN=<set_in_env>
APP_ENV=prod
LOG_LEVEL=INFO
WEB_PORT=8000
APP_MODULE=backend.app.main:app

# Telegram Bot
TELEGRAM_BOT_TOKEN=<set_in_env>
BOT_LOG_DIR=/var/log/app
BOT_LOG_FILE=/var/log/app/bot.log
ENABLE_TELEGRAM_BOT=1
CF_TUNNEL_TOKEN=<set_in_env>