# env.example - base template for backend/bot deployments

APP_ENV=production
APP_DEBUG=false
APP_VERSION=
LOG_LEVEL=INFO
WEB_PORT=8000
APP_MODULE=backend.app.main:app
TZ=UTC

POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
DATABASE_URL=
NEON_DATABASE_URL=
DATABASE_URL_SQLITE=
REDIS_URL=redis://cache:6379/0

SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60
ADMIN_USER=admin
ADMIN_PASS=
ADMIN_SECRET_TOKEN=
ADMIN_BASIC_REALM=Restricted

LOG_FILE=/var/log/app/web.log
BOT_LOG_DIR=/var/log/app
BOT_LOG_FILE=/var/log/app/bot.log

ENABLE_TELEGRAM_BOT=0
TELEGRAM_BOT_TOKEN=
BOT_TOKEN=
CF_TUNNEL_TOKEN=

CORS_ORIGINS=
HH_API_BASE=https://api.hh.ru
