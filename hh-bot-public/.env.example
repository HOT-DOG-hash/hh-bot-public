# Mandatory secrets (значения задаются в Vault/CI)
BASE_URL=__REQUIRED__  # Публичный URL сервиса (https://app.example.com)
DATABASE_URL=__REQUIRED__  # PostgreSQL DSN
REDIS_URL=__REQUIRED__  # Redis URI
SECRET_KEY=__REQUIRED__  # FastAPI secret key
ADMIN_USER=__REQUIRED__  # Admin basic auth login
ADMIN_PASS=__REQUIRED__  # Admin basic auth password
ADMIN_SECRET_TOKEN=__REQUIRED__  # Admin API token
TELEGRAM_BOT_TOKEN=__REQUIRED__  # Telegram bot token
YOOMONEY_WEBHOOK_SECRET=__REQUIRED__  # YooMoney webhook signature secret
CF_TUNNEL_TOKEN=__REQUIRED__  # Cloudflare tunnel token

# YooMoney / YooKassa OAuth
YOOMONEY_CLIENT_ID=__REQUIRED__  # OAuth client id
YOOMONEY_CLIENT_SECRET=__REQUIRED__  # OAuth client secret
YOOMONEY_REDIRECT_URI=__REQUIRED__  # https://app.example.com/oauth/yoomoney/callback
YOOMONEY_OAUTH_SCOPE=payments:write payments:read

# HeadHunter OAuth
HH_CLIENT_ID=__REQUIRED__  # OAuth client id (hh.ru)
HH_CLIENT_SECRET=__REQUIRED__  # OAuth client secret (hh.ru)
HH_REDIRECT_URI=__REQUIRED__  # https://app.example.com/oauth/hh/callback
HH_OAUTH_SCOPE=basic

# Optional настройки (оставь пустыми либо задавай локально)
APP_ENV=
LOG_LEVEL=
WEB_PORT=
APP_MODULE=
ENABLE_TELEGRAM_BOT=
BOT_LOG_FILE=
