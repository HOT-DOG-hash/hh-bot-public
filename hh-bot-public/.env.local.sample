APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=DEBUG
APP_VERSION=dev

WEB_PORT=8000
TZ=Europe/Moscow

POSTGRES_DB=hh
POSTGRES_USER=__REQUIRED__
POSTGRES_PASSWORD=__REQUIRED__
DATABASE_URL=__REQUIRED__
NEON_DATABASE_URL=__REQUIRED__

SECRET_KEY=__REQUIRED__
ADMIN_USER=admin
ADMIN_PASS=__REQUIRED__
ADMIN_SECRET_TOKEN=__REQUIRED__
ADMIN_BASIC_REALM=HHOFFER Admin
ACCESS_TOKEN_EXPIRE_MINUTES=60

CORS_ORIGINS=https://app.example.com,https://api.example.com,https://dev.example.com,http://localhost:5173,http://localhost:3000

# Логи — stdout/stderr
LOG_FILE=logs/app.log
BOT_LOG_DIR=logs
BOT_LOG_FILE=logs/bot.log

ENABLE_TELEGRAM_BOT=0
TELEGRAM_BOT_TOKEN=__REQUIRED__
CF_TUNNEL_TOKEN=__REQUIRED__
PUBLIC_BASE_URL=https://api.example.com

# Frontend build defaults (подстройте под ваш dev-прокси)
VITE_API_BASE=http://localhost:8000/api
VITE_USE_MOCKS=0

# YooMoney / YooKassa OAuth (canonical placeholders)
YOOMONEY_CLIENT_ID=__REQUIRED__  # YooMoney OAuth client_id
YOOMONEY_CLIENT_SECRET=__REQUIRED__  # YooMoney OAuth client_secret
YOOMONEY_REDIRECT_URI=https://localhost:8000/oauth/yoomoney/callback

# HeadHunter OAuth (canonical placeholders)
HH_CLIENT_ID=__REQUIRED__  # HeadHunter OAuth client_id
HH_CLIENT_SECRET=__REQUIRED__  # HeadHunter OAuth client_secret
HH_REDIRECT_URI=http://localhost:8000/oauth/hh/callback
